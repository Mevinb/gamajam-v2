    },
    {
      "key": "vo_a98be4db681daf60",
      "speaker": "ISLAND RADIO",
      "line": "Low water opens the culvert. Maintenance can take the service gate. Find the dry refuge beyond the fence.",
      "source": "Assets/Parasite/Scripts/Missions/IslandArrival.cs",
      "profile": "radio",
      "render_fit_window_seconds": 2.5,
      "reference_runtime_window_seconds": 5.99,
      "reference_duration_seconds": 5.84,
      "reference_ogg_sha256": "ebdbeb9efe5098eb20d377e38a58b9d6719f939303ebf24ffa85ce102e000345"
    },
    {
      "key": "vo_08e9ef6bdf74053a",
      "speaker": "ISLAND RADIO",
      "line": "You made it to the dry refuge. No one here belongs to Vale. Let us keep it that way.",
      "source": "Assets/Parasite/Scripts/Missions/IslandCampaign.cs",
      "profile": "radio",
      "render_fit_window_seconds": 5.38,
      "reference_runtime_window_seconds": 5.38,
      "reference_duration_seconds": 5.3,
      "reference_ogg_sha256": "5837fe81be115499d0db2bd40b0d80a1c647b47f2bb99f74667b68462a0ae0df"
    },
    {
      "key": "vo_ea1a47d9e59b0be6",
      "speaker": "ISLAND RADIO",
      "line": "The island has more than one route out. From this refuge, every route can become a connection.",
      "source": "Assets/Parasite/Scripts/Missions/IslandCampaign.cs",
      "profile": "radio",
      "render_fit_window_seconds": 5.83,
      "reference_runtime_window_seconds": 5.83,
      "reference_duration_seconds": 5.51,
      "reference_ogg_sha256": "5229b1f80edee1fd95e92f4ab8d6b49b702f5741e19169296cd958f5229b5a11"
    },
    {
      "key": "vo_fc1eae47d3a28931",
      "speaker": "ISLAND RADIO",
      "line": "All three reached the clinic. The rescue crew needs a mounted signal and everyone at the northern launch.",
      "source": "Assets/Parasite/Scripts/Missions/IslandTravelers.cs",
      "profile": "radio",
      "render_fit_window_seconds": 6.325,
      "reference_runtime_window_seconds": 6.325,
      "reference_duration_seconds": 5.91,
      "reference_ogg_sha256": "c23a93f0d81a8dc0cf9b71f0f58ddfde516bea642bbd1559917b91681fe480c8"
    },
    {
      "key": "vo_f019e6723e34f2d3",
      "speaker": "ISLAND RADIO",
      "line": "Three couriers carry the relay. Mount the signal, then let the handoff routes converge at the northern launch.",
      "source": "Assets/Parasite/Scripts/Missions/IslandTravelers.cs",
      "profile": "radio",
      "render_fit_window_seconds": 6.55,
      "reference_runtime_window_seconds": 6.55,
      "reference_duration_seconds": 5.77,
      "reference_ogg_sha256": "5f02c5448415864e5c013d14975560ef3e79da94b79bcf3f6b8aa94d99c5fa91"
    },
    {
      "key": "vo_6528d8124228c4ff",
      "speaker": "RESCUE RADIO",
      "line": "Everyone aboard. No borrowed heart left behind.",
      "source": "Assets/Parasite/Scripts/Core/GameManager.cs",
      "profile": "radio",
      "render_fit_window_seconds": 2.5,
      "reference_runtime_window_seconds": 3.32,
      "reference_duration_seconds": 3.17,
      "reference_ogg_sha256": "5b350e3ff7dd535316fd4a373d97edd2d0e4a86faedc69dd642148f53904656b"
    },
    {
      "key": "vo_332dc1ff69fc9f68",
      "speaker": "RESCUE RADIO",
      "line": "Every courier answered. The next shore is listening.",
      "source": "Assets/Parasite/Scripts/Core/GameManager.cs",
      "profile": "radio",
      "render_fit_window_seconds": 2.5,
      "reference_runtime_window_seconds": 3.36,
