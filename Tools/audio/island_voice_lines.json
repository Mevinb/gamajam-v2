    {
      "key": "vo_4ffb1013f0db8f10",
      "speaker": "SPECIMEN 7",
      "line": "Two currents met beneath the hull. One specimen reached the far shore.",
      "source": "Assets/Parasite/Scripts/Missions/IslandArrival.cs",
      "profile": "specimen",
      "render_fit_window_seconds": 1.5,
      "reference_runtime_window_seconds": 5.65,
