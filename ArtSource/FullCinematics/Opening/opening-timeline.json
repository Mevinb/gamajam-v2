    {
      "at": 0.5,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "Before faces, there was a rhythm."
    },
    {
      "at": 5,
      "speaker": "",
      "text": ""
    },
    {
      "at": 6,
      "speaker": "DR. HANA PETROV",
      "text": "Four taps. Then we begin."
    },
    {
      "at": 11,
      "speaker": "",
      "text": ""
    },
    {
      "at": 16,
      "speaker": "DR. HANA PETROV",
      "text": "You remembered."
    },
    {
      "at": 19.5,
      "speaker": "DR. VALE",
      "text": "It anticipated a stimulus."
    },
    {
      "at": 22,
      "speaker": "DR. HANA PETROV",
      "text": "It knew I was here."
    },
    {
      "at": 26.8,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "Two places. The same remembering."
    },
    {
      "at": 33,
      "speaker": "",
      "text": ""
    },
    {
      "at": 34.8,
      "speaker": "MAINTENANCE WORKER",
      "text": "That wasn't me."
    },
    {
      "at": 37.4,
      "speaker": "DR. HANA PETROV",
      "text": "End contact."
    },
    {
      "at": 39,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "A hand that wasn't mine. A heart that was."
    },
    {
      "at": 44,
      "speaker": "DR. HANA PETROV",
      "text": "Seven. Stay with the rhythm."
    },
    {
      "at": 50,
      "speaker": "",
      "text": ""
    },
    {
      "at": 53,
      "speaker": "DR. HANA PETROV",
      "text": "Who released the interlock?"
    },
    {
      "at": 56.5,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "Then the wall stopped."
    },
    {
      "at": 59,
      "speaker": "",
      "text": ""
    },
    {
      "at": 67.6,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "Outside, nobody knew the rhythm."
    },
    {
      "at": 75.2,
      "speaker": "SPECIMEN 7 \u00b7 MEMORY",
      "text": "I could make the next beat."
